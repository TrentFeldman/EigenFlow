# Python virtual environments
venv/
.venv/
env/
ENV/
data/
# Python cache
__pycache__/
*.pyc

# PyTorch checkpoints (the one released model in ode/models/ is the exception)
*.pt
*.pth
!ode/models/**/*.pt

# Experiment outputs stay local: run folders (metrics, charts, checkpoints),
# generated equation answers and animations. Publish a model via ode/models/.
ode/runs/*
ode/equations/**/*.svg
ode/equations/**/*.csv
ode/equations/**/*.html
ode/equations/my_equation.*

# Local experiments and scratch work
/.experiments/

# Agent instruction files
/AGENTS.md
/CLAUDE.md

# Per-equation evaluation dumps (tens of MB) and training videos stay local;
# the scores that matter are in each model's MODEL.md.
ode/models/**/evaluation_summary.json
ode/models/**/*.mp4
*.log
