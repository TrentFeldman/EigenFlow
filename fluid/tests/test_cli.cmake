# End-to-end checks in the build folder; never write into the user's saves/.
cmake_minimum_required(VERSION 3.20)
file(MAKE_DIRECTORY "${WORK}")
file(GLOB before LIST_DIRECTORIES true "${WORK}/saves/*")
list(LENGTH before before_count)
execute_process(COMMAND "${EXECUTABLE}" 3 2 vortex WORKING_DIRECTORY "${WORK}"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "CLI export failed: ${error}")
endif()
file(GLOB after LIST_DIRECTORIES true "${WORK}/saves/*")
list(LENGTH after after_count)
math(EXPR expected "${before_count}+1")
if(NOT after_count EQUAL expected)
    message(FATAL_ERROR "CLI did not create exactly one new run folder")
endif()
foreach(directory IN LISTS after)
    if(NOT directory IN_LIST before)
        set(created "${directory}")
    endif()
endforeach()
execute_process(COMMAND "${EXECUTABLE}" --config "${created}/resolved.cfg"
                WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Config replay failed: ${error}")
endif()
execute_process(COMMAND "${EXECUTABLE}" 0 2 WORKING_DIRECTORY "${WORK}"
                RESULT_VARIABLE invalid_result OUTPUT_QUIET ERROR_QUIET)
if(invalid_result EQUAL 0)
    message(FATAL_ERROR "Invalid dimensions accepted")
endif()
file(GLOB final LIST_DIRECTORIES true "${WORK}/saves/*")
list(LENGTH final final_count)
math(EXPR expected "${after_count}+1")
if(NOT final_count EQUAL expected)
    message(FATAL_ERROR "Replay overwrote a run or invalid CLI created output")
endif()
